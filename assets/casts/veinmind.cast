[0.000, "o", "n tasks, results, assets), CloudWalker CWPP (events, vulnerabilities, assets), VeinMind container security (agents, image/container/Kubernetes assets, baseline, websites, web frameworks,\u001b[39m\r\n                          \u001b[38;2;177;185;249mruntime risks), and T-Answer (firewall rules, blocklists). (user)\u001b[39m\r\n  \u001b[38;2;153;153;153m/add-dir\u001b[39m                \u001b[38;2;153;153;153mAdd a new working directory\u001b[39m\r\n  \u001b[38;2;153;153;153m/agents\u001b[39m                 \u001b[38;2;153;153;153mManage agent configurations\u001b[39m\r\n  \u001b[38;2;153;153;153m/chrome\u001b[39m                 \u001b[38;2;153;153;153mClaude in Chrome (Beta) settings\u001b[39m\r\n  \u001b[38;2;153;153;153m/clear\u001b[39m                  \u001b[38;2;153;153;153mClear conversation history and free up context\u001b[39m\r\n  \u001b[38;2;153;153;153m/compact\u001b[39m                \u001b[38;2;153;153;153mClear conversation history but keep a summary in context. Optional: /compact [instructions for summarization]\u001b[39m\r\n  \u001b[38;2;153;153;153m/config\u001b[39m                 \u001b[38;2;153;153;153mOpen config panel\u001b[39m\r\n"]
