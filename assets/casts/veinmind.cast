[0.000, "o", "or-prod:MFDE-26.05.008             │ 0        │ 1        │ 0        │\r\n  └─────┴─────────────────────┴─────────────────────────────────────────────────┴──────────┴──────────┴──────────┘\r\n  \u001b[1m概览\u001b[22m\r\n\r\n  - \u001b[1m全部容器均在运行中\u001b[22m（state=3），无停止或异常容器\r\n  - \u001b[1m高危漏洞 (level 4)\u001b[22m: 12 个容器各检出 1 个高危漏洞（veinmind-api、grafana、gateway、auth、coodinator、grpc、minio、nsqadmin/nsqd/nsqlookupd、static、only、machine-server、detector）\r\n  - \u001b[1m中危漏洞 (level 3)\u001b[22m: 仅 \u001b[38;2;177;185;249mveinmind-db\u001b[39m（MySQL 8.0.32）检出 5 个中危漏洞\r\n  - \u001b[1m无严重漏洞 (level 5)\u001b[22m: 所有容器均无严重漏洞\r\n  - \u001b[1m无风险容器\u001b[22m: prometheus、jaeger、veinmind-cache、skyeye-service、po"]
[0.000, "o", "stgres-db 共 5 个容器无任何检出漏洞\r\n\r\n  整体风险水平可控，但 veinmind-db (MySQL) 和多个 VeinMind 自有组件存在高危漏洞，建议重点关注。如需查看某个容器的详细信息，可以使用：\r\n\r\n  chaitin-cli veinmind container get --id <容器列表ID> -o json\r\n\r\n\u001b[38;2;215;119;87m✻\u001b[39m \u001b[38;2;235;159;127mWa\u001b[38;2;215;119;87mrping… \u001b[38;2;153;153;153m(\u001b[1mesc\u001b[22m to interrupt · 37s · ↓\u001b[39m \u001b[38;2;153;153;153m543 tokens)\u001b[39m\r\n  ⎿  \u001b[38;2;153;153;153mTip: Use /permissions to pre-approve and pre-deny bash, edit, and MCP tools\u001b[39m\r\n\r\n\u001b[2m\u001b[38;2;136;136;136m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
