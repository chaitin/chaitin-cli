[0.000, "o", "───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[22m\r\n  \u001b[38;2;177;185;249m/cws-cli\u001b[39m                \u001b[38;2;177;185;249mOperate the `cws` CLI for Chaitin products, especially when Codex needs to inspect available commands, build a safe invocation, use `--dry-run`, query DDR or CloudWalker data, or execute a concrete `cws` subcommand for\u001b[39m\r\n                          \u001b[38;2;177;185;249mtroubleshooting, inventory, audit, policy, approval, o"]
[0.000, "o", "r device-management tasks. (user)\u001b[39m\r\n  \u001b[38;2;153;153;153m/add-dir\u001b[39m                \u001b[38;2;153;153;153mAdd a new working directory\u001b[39m\r\n  \u001b[38;2;153;153;153m/agents\u001b[39m                 \u001b[38;2;153;153;153mManage agent configurations\u001b[39m\r\n  \u001b[38;2;153;153;153m/chrome\u001b[39m                 \u001b[38;2;153;153;153mClaude in Chrome (Beta) settings\u001b[39m\r\n  \u001b[38;2;153;153;153m/clear\u001b[39m                  \u001b[38;2;153;153;153mClear conversation history and free up context\u001b[39m\r\n  \u001b[38;2;153;153;153m/compact\u001b[39m                \u001b[38;2;153;153;153mClear conversation history but keep a summary in context. Optional: /compact [instructions for summarization]\u001b[39m\r\n  \u001b[38;2;153;153;153m/config\u001b[39m                 \u001b[38;2;153;153;153mOpen config panel\u001b[39m\r\n  \u001b[38;2;153;153;153m/context\u001b[39m                \u001b[38;2;153;153;153mVisualize current context usage as a colored grid\u001b[39m\r\n  \u001b[38;2;153;153;153m/cost\u001b[39m                   \u001b[38;2;153;153;153mShow the total cost and duration of the current session\u001b[39m\r\n  \u001b[38;2;153;1"]
