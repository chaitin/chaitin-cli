[0.001, "o", "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[22m\r\n  \u001b[38;2;177;185;249m/export\u001b[39m                 \u001b[38;2;177;185;249mExport the current conversation to a file or clipboard\u001b[39m\r\n  \u001b[38;2;153;153;153m/exit\u001b[39m                   \u001b[38;2;153;153;153mExit the REPL\u001b[39m\r\n  \u001b[38;2;153;153;153m/cws-cli\u001b[39m                \u001b[38;2;153;153;153mOperate the `cws"]
[0.000, "o", "` CLI for Chaitin products, especially when Codex needs to inspect available commands, build a safe invocation, use `--dry-run`, query DDR or CloudWalker data, or execute a concrete `cws` subcommand for\u001b[39m\r\n                          \u001b[38;2;153;153;153mtroubleshooting, inventory, audit, policy, approval, or device-management tasks. (user)\u001b[39m\r\n  \u001b[38;2;153;153;153m/security-review\u001b[39m        \u001b[38;2;153;153;153mComplete a security review of the pending changes on the current branch\u001b[39m\r\n  \u001b[38;2;153;153;153m/clear\u001b[39m                  \u001b[38;2;153;153;153mClear conversation history and free up context\u001b[39m\r\n  \u001b[38;2;153;153;153m/release-notes\u001b[39m          \u001b[38;2;153;153;153mView release notes\u001b[39m\r\n  \u001b[38;2;153;153;153m/rewind\u001b[39m                 \u001b[38;2;153;153;153mRestore the code and/or conversation to a previous point\u001b[39m\r\n  \u001b[38;2;153;153;153m/permissions\u001b[39m            \u001b[38;2;153;153;153mManage allow & deny tool permission rules\u001b[39m\r\n  \u001b[38;2;153;153;153m/output-style\u001b[39m           \u001b[38;2;153;153"]
[0.000, "o", ";153mSet the output style directly or from a selection menu\u001b[39m\r\n  \u001b[38;2;153;153;153m/memory\u001b[39m                 \u001b[38;2;153;153;153mEdit Claude memory files\u001b[39m\r\n\u001b[?2026l"]
