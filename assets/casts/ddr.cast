[1.249, "o", "\u001b[?2026h\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[38;2;255;255;255m⏺\u001b[39m 我已经成功查询到了网络管理相关的日志。让我为您总结一下最近的网络管理日志情况：\r\n\r\n  \u001b[1m网络管理日志查询结果\u001b[22m\r\n\r\n  \u001b[1m查询条件\u001b[22m\r\n\r\n  - 查询命令：\u001b[38;2;177;185;249mcws ddr policylog softwarenetwork list --page 1 --limit 20 --search \"\" -o json\u001b[39m\r\n  - 查询时间：当前时间（2026年4月）\r\n  - 结果数量：返回了20条日志记录\r\n\r\n  \u001b[1m日志统计\u001b[22m\r\n\r\n  \u001b[1m按时间分布（最近一周）\u001b[22m\r\n\r\n  - \u001b[1m4月14日\u001b[22m：5条记录（当天）\r\n  - \u001b[1m4月9日\u001b[22m：2条记录\r\n  - \u001b[1m1月15日\u001b[22m：3条记录\r\n  - 其他时间：10条记录\r\n\r\n  \u001b[1m按设备分布\u001b[22m\r\n\r\n  - \u001b[1mPC-000298\u001b[22m（yym99@DESKTOP-7T9MC7A）：5条记录\r\n  - \u001b[1mPC-000044\u001b[22m（lianb@TEST-SOUMAO-123）：2条记录\r\n  - \u001b[1mPC-000183\u001b[22m（huyajie333）：3条记录\r\n  - 其他设备：10条记录\r\n\r\n  \u001b[1m按策略分类\u001b[2"]
[0.000, "o", "2m\r\n\r\n  1. \u001b[1m限定禁网策略\u001b[22m（net_limit_drop）：7条记录\r\n    - 策略名称：\"yy-test\"（PC-000298）、\"win-限定联网-域名\"（PC-000044）\r\n    - 被阻止的域名：\u001b]8;;http://www.jd.com、pan.baidu.com\u0007\u001b[34mhttp://www.jd.com、pan.baidu.com\u001b[39m\u001b]8;;\u0007\r\n    - 涉及程序：msedge.exe、wechatappex.exe\r\n  2. \u001b[1m禁止联网策略\u001b[22m（net_banned）：3条记录\r\n    - 策略名称：\"hu禁止联网(qq\"（PC-000183）\r\n    - 被阻止的程序：腾讯QQ\r\n    - 目标IP：42.81.184.82、222.94.109.78\r\n\r\n  \u001b[1m典型日志示例\u001b[22m\r\n\r\n  \u001b[1m1. PC-000298（Windows 11）访问京东被阻止\u001b[22m\r\n\r\n  时间：2026-04-14 12:41:06\r\n  设备：PC-000298 (192.168.18.129)\r\n  用户：yym99\r\n  程序：msedge.exe (Microsoft Edge)\r\n  目标：www.jd.com (192.168.89.53)\r\n  策略：yy-test\r\n  动作：限定禁网\r\n\r\n  \u001b[1m2. PC-000044（Windows 10）访问百度网盘被阻止\u001b[22m\r\n\r\n  时间：2026-04-09 15:47:58\r\n  设备：PC-000044 (192.168.96.140)\r\n  用户：lianb\r\n  程序：WeCha"]
